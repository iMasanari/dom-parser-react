{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "es5",
      "es2015.Iterable",
      "dom"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "dom-parser-react/window": [
        "./src/window.node.ts"
      ]
    },
    "jsx": "react-jsx",
    "outDir": "dist/",
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["vitest/jsdom"]
  }
}